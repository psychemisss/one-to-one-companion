# Copy to .env. Every key is optional; shown values are the defaults.
# APP_NAME=1:1 Companion
# TIMEZONE=Europe/Kyiv
# DEFAULT_LANGUAGE=en            # en | ru
# DEFAULT_CADENCE_DAYS=75        # target gap between 1:1s for new engineers
# DUE_SOON_DAYS=14               # dashboard highlights engineers due within this many days
# DB_PATH=/data/one_on_one.db    # local dev: data/one_on_one.db (compose always uses /data)
# APP_PASSWORD=                  # set to enable HTTP Basic auth (any username)
# LOG_LEVEL=INFO
# LOG_TO_FILE=true
# LOG_DIR=/data/logs             # local dev: data/logs (compose always uses /data/logs)
# LOG_ROTATION=10 MB
# LOG_RETENTION=14 days
